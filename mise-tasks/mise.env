FORCE_COLOR="1"
GITHUB_REPO_OWNER="hotdog-werx"
GITHUB_REPO_NAME="devkit"
GITHUB_REPO="hotdog-werx/devkit"

GIT_CLIFF_CONFIG = "./cliff.toml"
# devkit is a bare uv workspace container (package = false, no
# [tool.uv.build-backend] module-name) — python:check:coverage's normal
# auto-detection would fall back to the wrong target, so it's set
# explicitly here instead.
DK_PYTEST_COV_TARGET = "devkit"
# devkit hosts its own providers as workspace members, so repolish comes
# from the project venv (a dependency of the members) instead of a
# uv-toolbox env: the task templates' DK_UVTB_REPOLISH_EXEC prefix is
# overridden to empty, and mise's uv_venv_auto puts repolish on PATH.
# The uv-toolbox form stays the default for consumer repos.
DK_UVTB_REPOLISH_EXEC = ""
