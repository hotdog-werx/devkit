#!/usr/bin/env python3
"""Run complexipy's cognitive complexity checker.

Threshold is configurable per-repo via the COMPLEXIPY_THRESHOLD env var
(e.g. set in mise.toml's [env]), defaulting to 10 if unset. complexipy
lives in the uv-toolbox "tools" environment and runs through the
DK_UVTB_TOOLS_EXEC prefix (the env defaults file provides it); a repo
that installs its own complexipy overrides the variable to "".
"""

import os
import shlex
import subprocess
import sys

if __name__ == '__main__':
    threshold = os.environ.get('COMPLEXIPY_THRESHOLD', '10')
    prefix = shlex.split(os.environ.get('DK_UVTB_TOOLS_EXEC', ''))
    cmd = [*prefix, 'complexipy', '-mx', threshold, '.']
    sys.exit(subprocess.run(cmd, check=False).returncode)
