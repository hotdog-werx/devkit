# {{ repolish.generated_header }}
name: ci-checks

on:
  pull_request:
    branches: [master]
  push:
    branches: [master]

jobs:
  repo-checks:
    uses: {{ devkit_workflow_prefix }}__workspace_repo-checks.yaml{{ devkit_workflow_suffix }}
    with:
      enable-docs: {{ enable_docs | lower }}
{% if has_python %}
  python-checks:
    uses: {{ devkit_workflow_prefix }}__python_python-checks.yaml{{ devkit_workflow_suffix }}
    with:
      operating-systems: '{{ python_operating_systems | tojson }}'
      codecov: {{ python_codecov | lower }}
{%- if python_mustard %}
      mustard: true
{%- if python_mustard_flag %}
      mustard-flag: {{ python_mustard_flag }}
{%- endif %}
{%- endif %}
    secrets:
      CODECOV_TOKEN: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
{% if python_mustard %}
  # Mustard's report job publishes checks, comments, signed baselines, and the
  # badge, so it runs here with its own permissions. A reusable workflow job
  # requesting them would fail every caller that does not grant them.
  coverage:
    needs: [python-checks]
    if: always() && !cancelled()
    runs-on: ubuntu-latest
    permissions:
      contents: write
      actions: read
      checks: write
      pull-requests: write
      id-token: write
      attestations: write
    steps:
      - uses: hotdog-werx/mustard@e9c320bfef82780bb473edc8c1a9bc6e40324360 # 0.1.0
        with:
          fail-ci: 'true'
{% endif %}{% endif %}{% raw %}
## repolish:keep-block[custom-ci-checks]: start="## start-custom-ci-checks" end="## end-custom-ci-checks"
  ## start-custom-ci-checks
  ## Add custom jobs here (e.g. a tests/test-action pair). Content between
  ## these two marker lines is preserved verbatim across repolish
  ## re-applies — GitHub Actions `needs:` only works between jobs in the
  ## same file, so jobs that must depend on repo-checks/python-checks
  ## belong here rather than in a separate workflow file.
  ##
  ## Repolish matches these markers independent of indentation, allowing
  ## YAML formatters to align them with the surrounding jobs safely.
  ## end-custom-ci-checks
{%- endraw %}
